ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override default timezone (e.g. America/Chicago, America/Los_Angeles)
TIMEZONE=America/New_York

# Robinhood Agentic Trading OAuth token
# Obtain via: robinhood.com/us/en/agentic-trading/
ROBINHOOD_MCP_TOKEN=your_robinhood_oauth_token_here

# How often to poll Gmail for new trading emails (seconds)
POLL_INTERVAL_SECONDS=60

# Gmail search query to find trading instruction emails
TRADING_EMAIL_QUERY=is:unread subject:TRADE label:inbox
